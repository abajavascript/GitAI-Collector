# The process reads the environment. It does not load this file.
# Export these values in the shell before npm run dev or npm start.
# PUBLIC_BASE_URL should use the same host and port the process listens on.
HOST=127.0.0.1
PORT=8080
SQLITE_PATH=data/collector.sqlite
# Prefer KEYS_FILE in production. When set, API_KEYS and BEARER_TOKENS are ignored.
KEYS_FILE=
API_KEYS=replace-me
BEARER_TOKENS=
PUBLIC_BASE_URL=http://127.0.0.1:8080
