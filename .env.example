# npm run dev and npm start load this file from the working directory.
# Copy it to .env. A variable already set in the process environment is kept.
# Do not commit .env. Restart the process after changing it.
# PUBLIC_BASE_URL should use the same host and port the process listens on.
HOST=127.0.0.1
PORT=8080
SQLITE_PATH=data/collector.sqlite
# Prefer KEYS_FILE in production. When set, API_KEYS and BEARER_TOKENS are ignored.
KEYS_FILE=
API_KEYS=replace-me
BEARER_TOKENS=
PUBLIC_BASE_URL=http://127.0.0.1:8080
