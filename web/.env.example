# Server-only. The browser never receives these values.
# Copy to web/.env. Next.js reads that file; do not commit it.
COLLECTOR_BASE_URL=http://127.0.0.1:8080
# Read key (for example the analytics key in docs/read-api.md). Not a write key.
COLLECTOR_READ_KEY=
# Optional. When empty, Next listens on localhost only and does not ask for a password.
DASHBOARD_PASSWORD=
